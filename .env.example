# Optional overrides. The current production calendar/location IDs remain the fallback values.
GHL_LOCATION_ID=
GHL_CALENDAR_ID=

# Required server-only HighLevel private integration token. Grant Contacts Write and Calendars/Events Write access.
GHL_PRIVATE_INTEGRATION_TOKEN=

# Private HighLevel Inbound Webhook URL. Configure this only on the server/deployment.
GHL_BOOKING_WEBHOOK_URL=
